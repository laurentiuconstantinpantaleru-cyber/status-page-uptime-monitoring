# Copy to .env and replace the placeholder values. Never commit .env.

# Web server
PORT=3000

# MySQL (read by docker-compose.yml). The root password is generated at first start
# and never needed by the app.
MYSQL_USER=uptime
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=uptime
MYSQL_RANDOM_ROOT_PASSWORD=yes

# Connection string used by the web server and workers
DATABASE_URL=mysql://uptime:change-me@localhost:3307/uptime

# Monthly report email (Q-004, D-041), e.g. smtps://user:password@smtp.example.com:465.
# Unset: reports are stored and can be downloaded, but not emailed until both are set.
SMTP_URL=
MAIL_FROM=

# Alerts (D-007, D-044). The bot token comes from @BotFather; unset, Telegram alerts wait.
# PUBLIC_URL is where acknowledge links point, e.g. https://status.example.ro; unset, alerts
# tell people to acknowledge in the admin panel.
TELEGRAM_BOT_TOKEN=
PUBLIC_URL=http://localhost:3000

# Worker degradation (D-015). Unset: 3 monitors, 70 %, 10 minutes.
# MIN_WORKER_MONITORS=3
# WORKER_FAULT_THRESHOLD=70
# WORKER_FAULT_WINDOW_MINUTES=10

# Throwaway database for the schema tests; they wipe it, so its name must end in _test.
# Unset: those tests are skipped.
TEST_DATABASE_URL=mysql://root:change-me@localhost:3308/uptime_test
