{
  "name": "status-page-uptime-monitoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:web": "node dist/web/server.js",
