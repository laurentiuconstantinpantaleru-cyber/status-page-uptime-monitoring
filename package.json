    "lint": "tsc -p tsconfig.json --noEmit && python3 docs/agents/tools/ledger-lint.py"
  },
  "dependencies": {
    "eta": "^4.6.0",
    "fastify": "^5.12.8",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
