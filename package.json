{
  "name": "status-page-uptime-monitoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:web": "node dist/web/server.js",
    "start:worker": "node dist/worker/main.js",
    "db:migrate": "node dist/db/migrate.js",
    "user:create": "node dist/cli/user-create.js",
    "apikey:create": "node dist/cli/apikey-create.js",
    "contact:add": "node dist/cli/contact-add.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit && python3 docs/agents/tools/ledger-lint.py"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "eta": "^4.6.0",
    "fastify": "^5.12.8",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
